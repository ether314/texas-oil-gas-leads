# Firebase Admin credentials for project txog-leads-k7q2m.
# Copy to .env (gitignored) or set these in the cloud environment settings.
# Values come from a service-account key: Firebase console > Project settings > Service accounts.

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the key on one line with its newlines written as \n, inside double quotes.
FIREBASE_PRIVATE_KEY=
